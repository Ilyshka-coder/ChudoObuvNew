<Page x:Class="ЧудоОбувь.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аналитика продаж" FontFamily="Calibri" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Аналитика продаж" FontSize="26" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>

        <!-- Панель выбора периода -->
        <Border Grid.Row="1" Background="#F2F9F7" CornerRadius="6" Padding="15,10" Margin="0,0,0,15" BorderBrush="#FF70B2AF" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Период с:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Name="StartDatePicker" Width="140" Height="30" FontSize="14" VerticalAlignment="Center"/>
                    
                    <TextBlock Text="по:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <DatePicker Name="EndDatePicker" Width="140" Height="30" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Name="ErrorTB" Text="Дата начала не может быть позже даты окончания!" 
                           Foreground="Red" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Сводные карточки -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Карточка: Заказы -->
            <Border Grid.Column="0" Background="#F9FBFB" BorderBrush="#D2E8E6" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="Общее количество заказов:" FontSize="16" Foreground="#666666"/>
                    <TextBlock Name="OrdersCountTB" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF70B2AF" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Карточка: Выручка -->
            <Border Grid.Column="2" Background="#F9FBFB" BorderBrush="#D2E8E6" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="Общая сумма продаж:" FontSize="16" Foreground="#666666"/>
                    <TextBlock Name="TotalSumTB" Text="0.00 руб." FontSize="28" FontWeight="Bold" Foreground="#FF70B2AF" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Топ-5 моделей -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Топ-5 моделей обуви по количеству проданных пар" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>

            <DataGrid Name="TopProductsGrid" Grid.Row="1" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="White" RowHeight="35" FontSize="14">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF70B2AF"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Padding" Value="10,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Position}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Наименование модели" Binding="{Binding ProductName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerName}" Width="250">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Количество пар" Binding="{Binding SoldQuantity}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Name="EmptyMessageTB" Grid.Row="1" Text="За выбранный период заказов не найдено" 
                       FontSize="16" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Кнопка экспорта -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnExportPdf" Content="Экспорт в PDF" Width="180" Height="40" 
                    Background="#FF70B2AF" Foreground="Black" FontSize="16" FontWeight="SemiBold" 
                    Click="BtnExportPdf_Click"/>
        </StackPanel>
    </Grid>
</Page>
