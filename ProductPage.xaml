<Page x:Class="ЧудоОбувь.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ЧудоОбувь"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Каталог Обуви"
      FontFamily="Calibri" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Name="SearchPanel" Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="5" HorizontalAlignment="Right">
            <TextBlock Text="Поиск: " FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

            <TextBox Name="SearchTB" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350"
             TextChanged="SearchTB_TextChanged"></TextBox>
        </StackPanel>

        <StackPanel Name="FilterPanel" Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="Фильтрация" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <ComboBox Name="FiltCB" Width="120" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"
              SelectionChanged="FiltCB_SelectionChanged">
                <TextBlock>Все</TextBlock>
                <TextBlock>Детская обувь</TextBlock>
                <TextBlock>Женская обувь</TextBlock>
                <TextBlock>Мужская обувь</TextBlock>
            </ComboBox>
        </StackPanel>

        <StackPanel Name="SortPanel" Orientation="Horizontal" Grid.Row="0" Grid.Column="2" Margin="5">
            <TextBlock Text="Сортировка " FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" ></TextBlock>
            <ComboBox Name="SortCB" Width="250" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" SelectionChanged="SortCB_SelectionChanged">
                <TextBlock>Все</TextBlock>
                <TextBlock>По убыванию цены</TextBlock>
                <TextBlock>По возрастанию цены</TextBlock>
            </ComboBox>
        </StackPanel>

        <ListView Name="ProductListView" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                    <EventSetter Event="Loaded" Handler="ListViewItem_Loaded"></EventSetter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{Binding ItemColor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" Grid.RowSpan="6" Grid.Column="0" Width="150" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Source>
                                <Binding Path="PhotoPath">
                                    <Binding.TargetNullValue>
                                        /res/picture.png
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0">
                            <TextBlock Text="{Binding ManufacturerName}" HorizontalAlignment="Left" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"></TextBlock>
                            <TextBlock Text=" | " HorizontalAlignment="Left" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"></TextBlock>
                            <TextBlock Text="{Binding ProductName}" HorizontalAlignment="Left" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" >
                            <TextBlock Text="Категория: " FontSize="16" FontWeight="SemiBold"></TextBlock>
                            <TextBlock Text="{Binding CategoryFull}" FontSize="16" ></TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="3">
                            <TextBlock Text="Описание: " FontSize="16" FontWeight="SemiBold"></TextBlock>
                            <TextBlock Text="{Binding Description}" FontSize="15"  TextWrapping="Wrap"></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="4">
                            <TextBlock Text="Состав: " FontSize="16" FontWeight="SemiBold"></TextBlock>
                            <TextBlock Text="{Binding Composition}" FontSize="16" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2">
                            <TextBlock Text="Количество: " FontSize="16" FontWeight="SemiBold"></TextBlock>
                            <TextBlock FontSize="16" Name="ProductQuantityTB"></TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Grid.Column="2" Grid.RowSpan="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Цена: " FontSize="20" FontWeight="SemiBold"></TextBlock>
                                <TextBlock Text="{Binding Price}" FontSize="22" ></TextBlock>
                                <TextBlock Text=" руб." FontSize="20" FontWeight="SemiBold"></TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Name="OrderPanel" Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="6" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Button Content="В корзину" Tag="{Binding}" Click="AddToCart_Click" FontSize="16" Height="35" Padding="15,0" Background="#FF70B2AF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

